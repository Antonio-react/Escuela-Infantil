      "html": "<div class=\"ds-cuaderno\"><p>Hola, me llamo <input class=\"ds-hueco\" aria-label=\"Nombre\" placeholder=\"tu nombre\"></p></div>",
      "css": ".ds-cuaderno{--c:1.25rem;--m:4rem;--l:rgb(45 170 225/.16);position:relative;padding:1.25rem 1.5rem 1.25rem 5rem;font-family:\"Nunito Variable\",sans-serif;font-size:1.25rem;line-height:2.5rem;color:#2b2830;background:linear-gradient(90deg,transparent calc(var(--m) - 1px),rgb(185 71 80/.6) calc(var(--m) - 1px) calc(var(--m) + 1px),transparent calc(var(--m) + 1px)),linear-gradient(var(--l) 1px,transparent 1px) 0 0/var(--c) var(--c),linear-gradient(90deg,var(--l) 1px,transparent 1px) 0 0/var(--c) var(--c),#fff;box-shadow:0 0 0 1px rgb(43 40 48/.05),0 1rem 2.5rem rgb(43 40 48/.1);}.ds-cuaderno p{margin:0;}.ds-hueco{appearance:none;border:none;border-bottom:2px solid rgb(43 40 48/.35);background:transparent;font:inherit;color:#79386e;width:12rem;}.ds-hueco:focus-visible{outline:3px solid #79386e;outline-offset:3px;}"
    },
