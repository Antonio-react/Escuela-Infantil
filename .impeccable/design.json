      "css": ".ds-pizarra{background:#252826;color:#f1eee6;padding:1.5rem;border-radius:1rem;border:.8rem solid #9a6a40;}.ds-btn-tiza{display:inline-flex;align-items:center;min-height:3rem;padding:0 1.2rem;border:2px solid currentColor;border-radius:9999px;font-family:\"Patrick Hand\",cursive;font-size:1.3rem;color:inherit;text-decoration:none;transition:transform 160ms cubic-bezier(.23,1,.32,1),background-color 200ms ease;}.ds-btn-tiza:hover{background:rgb(255 255 255/.08);}.ds-btn-tiza:active{transform:scale(.97);}.ds-btn-tiza:focus-visible{outline:3px solid #79386e;outline-offset:3px;}"
