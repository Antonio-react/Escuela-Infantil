      "css": ".ds-folio{position:relative;max-width:18rem;padding:1.5rem;background:#fff;color:#2b2830;font-family:\"Nunito Variable\",sans-serif;border-radius:2px 2px 3.5rem 2px/2px 2px .9rem 2px;box-shadow:0 0 0 1px rgb(43 40 48/.06),0 .25rem .75rem rgb(43 40 48/.08);}.ds-folio strong{font-family:\"Fredoka Variable\",sans-serif;color:#356943;font-size:1.25rem;}.ds-folio::after{content:'';position:absolute;right:0;bottom:0;width:30%;height:14%;background:radial-gradient(ellipse at 100% 100%,rgb(43 40 48/.12),transparent 70%);}"
