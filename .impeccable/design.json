  "components": [
    {
      "name": "Botón principal",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Acción principal de una sección: verde con letra blanca.",
      "html": "<button class=\"ds-btn-principal\">Ver la escuela</button>",
      "css": ".ds-btn-principal{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;min-height:3rem;padding:0 1.5rem;border-radius:9999px;font-family:\"Fredoka Variable\",ui-rounded,sans-serif;font-weight:600;font-size:1.0625rem;border:none;cursor:pointer;transition:transform 160ms cubic-bezier(.23,1,.32,1),background-color 200ms ease;background:#356943;color:#fff;}.ds-btn-principal:hover{background:#2c5638;}.ds-btn-principal:active{transform:scale(.97);}.ds-btn-principal:focus-visible{outline:3px solid #79386e;outline-offset:3px;}"
    },
